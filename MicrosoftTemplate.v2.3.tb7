          <Label>Possible Mitigation(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Enable diagnostics logging for web apps in Azure App Service. Refer: &lt;a href="https://aka.ms/tmtauditlog#diagnostics-logging"&gt;
https://aka.ms/tmtauditlog#diagnostics-logging&lt;/a&gt;</Value>
          </Values>

          <Name>PossibleMitigations</Name>
          <Label>Possible Mitigation(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Ensure that devices connecting to Field or Cloud gateway are authenticated. Refer:
&lt;a href="https://aka.ms/tmtauthn#authn-devices-cloud"&gt;https://aka.ms/tmtauthn#authn-devices-cloud&lt;/a&gt;</Value>
          </Values>
          <Description>List of possbile mitigations.</Description>
          <Id>PossibleMitigations</Id>

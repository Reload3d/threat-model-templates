        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>PossibleMitigations</Name>
          <Label>Possible Mitigation(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Ensure that the default login credentials of the field gateway are changed during installation. Refer:
&lt;a href="https://aka.ms/tmtconfigmgmt#default-change"&gt;https://aka.ms/tmtconfigmgmt#default-change&lt;/a&gt;</Value>
          </Values>
          <Description>List of possbile mitigations.</Description>
          <Id>PossibleMitigations</Id>
          <AttributeType>2</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>SDLPhase</Name>
          <Label>SDL Phase</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Implementation</Value>
          </Values>
          <Description>The Security Development Lifecycle Phase to be implemented.</Description>
          <Id>SDLPhase</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Steps</Name>
          <Label>Steps</Label>
          <HideFromUI>false</HideFromUI>
          <Values>

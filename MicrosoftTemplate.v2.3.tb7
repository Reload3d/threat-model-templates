          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>https://csf.tools/reference/cloud-controls-matrix/v4-0/dsi/dsi-06/</Value>
          </Values>
          <Description>Link to documentation</Description>
          <Id>Documentation</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Steps</Name>
          <Label>Steps</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>For each SaaS in scope, document the configured region, the subprocessor list, and the data classes sent. Confirm alignment with residency requirements.</Value>
          </Values>
          <Description>Perscriptive guidance on how to implement mitigations.</Description>
          <Id>Steps</Id>
          <AttributeType>2</AttributeType>

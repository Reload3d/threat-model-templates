      <Id>TH39</Id>
      <ShortTitle>An adversary may exploit known vulnerabilities in unpatched devices</ShortTitle>
      <Category>T</Category>
      <Description>An adversary may leverage known vulnerabilities and exploit a device if the firmware of the device is not updated</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>
          <Values>
            <Value xsi:nil="true" />
          </Values>
          <Id>22222222-2222-2222-2222-222222222222</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>UserThreatDescription</Name>
          <Label>Description</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>An adversary may leverage known vulnerabilities and exploit a device if the firmware of the device is not updated</Value>
          </Values>
          <Id>22222222-2222-2222-2222-222222222222</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Priority</Name>
          <Label>Severity</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>High</Value>
          </Values>
          <Description>Priority</Description>
          <Id>22222222-2222-2222-2222-222222222222</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>PossibleMitigations</Name>
          <Label>Possible Mitigation(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Ensure that the Cloud Gateway implements a process to keep the connected devices firmware up to date. Refer:
&lt;a href="https://aka.ms/tmtconfigmgmt#cloud-firmware"&gt;https://aka.ms/tmtconfigmgmt#cloud-firmware&lt;/a&gt;</Value>
          </Values>
          <Description>List of possbile mitigations.</Description>
          <Id>PossibleMitigations</Id>
          <AttributeType>2</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>SDLPhase</Name>
          <Label>SDL Phase</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Design</Value>

          <Name>PossibleMitigations</Name>
          <Label>Possible Mitigation(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Do not use access tokens that provide direct access to the Event Hub. Refer:
&lt;a href="https://aka.ms/tmtauthz#access-tokens-hub"&gt;https://aka.ms/tmtauthz#access-tokens-hub&lt;/a&gt;</Value>
          </Values>
          <Description>List of possbile mitigations.</Description>
          <Id>PossibleMitigations</Id>
          <AttributeType>2</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>

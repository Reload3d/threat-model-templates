        <ThreatMetaDatum>
          <Name>Steps</Name>
          <Label>Steps</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Identify users who query sensitive sources from notebooks. Confirm DLP and label-inheritance policy applies to notebook outputs.</Value>

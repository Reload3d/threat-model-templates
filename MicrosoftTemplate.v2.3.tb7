          <Label>Documentation</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>https://learn.microsoft.com/en-us/fabric/data-engineering/library-management</Value>
          </Values>
          <Description>Link to documentation</Description>
          <Id>Documentation</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Steps</Name>
          <Label>Steps</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>List the libraries, JARs, and environments attached to each workspace. Confirm the source, version pinning, and review process for each. Identify production workspaces where library upload should be restricted.</Value>
          </Values>
          <Description>Perscriptive guidance on how to implement mitigations.</Description>
          <Id>Steps</Id>

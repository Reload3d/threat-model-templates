        <ThreatMetaDatum>
          <Name>PossibleMitigations</Name>
          <Label>Possible Mitigation(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Maintain an internal allowlist of approved extensions and MCP servers, vetted before approval. Pin versions and disable automatic updates for security-sensitive tooling. Prefer extensions with reproducible builds and signed releases. Periodically audit installed extensions across the developer fleet.</Value>
          </Values>
          <Description>List of possbile mitigations.</Description>

          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>PossibleMitigations</Name>
          <Label>Possible Mitigation(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Grant fine-grained permission on a range of entities in Azure Table Storage. Refer:
&lt;a href="https://aka.ms/tmtauthz#permission-entities"&gt;https://aka.ms/tmtauthz#permission-entities&lt;/a&gt;</Value>
          </Values>
          <Description>List of possbile mitigations.</Description>
          <Id>PossibleMitigations</Id>
          <AttributeType>2</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>SDLPhase</Name>
          <Label>SDL Phase</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Implementation</Value>
          </Values>
          <Description>The Security Development Lifecycle Phase to be implemented.</Description>
          <Id>SDLPhase</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Documentation</Name>
          <Label>Documentation</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>https://azure.microsoft.com/documentation/articles/storage-security-guide/#_data-plane-security</Value>
          </Values>
          <Description>Link to documentation</Description>
          <Id>Documentation</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Steps</Name>
          <Label>Steps</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>In certain business scenarios, Azure Table Storage may be required to store sensitive data that caters to different parties. E.g., sensitive data pertaining to different countries. In such cases, SAS signatures can be constructed by specifying the partition and row key ranges, such that a user can access data specific to a particular country.</Value>
          </Values>
          <Description>Perscriptive guidance on how to implement mitigations.</Description>
          <Id>Steps</Id>
          <AttributeType>2</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Effort</Name>
          <Label>Effort</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Low</Value>
          </Values>
          <Description>The level of effort to apply mitigations.</Description>
          <Id>Effort</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>305b55ed-544e-422f-9deb-6507dacd18d1</Name>
          <Label>Azure Control</Label>
          <HideFromUI>false</HideFromUI>

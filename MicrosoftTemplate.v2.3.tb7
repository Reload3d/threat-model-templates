      <Id>TH32</Id>
      <ShortTitle>An adversary can spoof the target web application due to insecure TLS certificate configuration</ShortTitle>
      <Category>S</Category>
      <Description>Ensure that TLS certificate parameters are configured with correct values</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>
          <Values>
            <Value xsi:nil="true" />
          </Values>
          <Id>22222222-2222-2222-2222-222222222222</Id>

          <Id>Documentation</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Steps</Name>
          <Label>Steps</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Inventory the Azure resource types in scope and the diagnostic settings policy applied. Confirm a central destination is configured and that resource owners cannot suppress logging unilaterally.</Value>

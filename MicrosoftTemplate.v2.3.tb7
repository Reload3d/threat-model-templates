          <Values>
            <Value>https://learn.microsoft.com/en-us/azure/ai-services/openai/concepts/content-filter</Value>
          </Values>
          <Description>Link to documentation</Description>
          <Id>Documentation</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Steps</Name>
          <Label>Steps</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Document the application's acceptable-use boundaries. Identify the input and output classifiers that enforce them, the categories each covers, and the action taken on a violation. Confirm violations are logged and reviewable.</Value>

      <Id>TH35</Id>
      <ShortTitle>An adversary may spoof {source.Name} with a fake one</ShortTitle>
      <Category>S</Category>
      <Description>An adversary may replacing the {source.Name} or part of the {source.Name} with some other {source.Name}. </Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>

          <Label>Documentation</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>https://learn.microsoft.com/en-us/power-pages/security/assign-entity-permissions</Value>
          </Values>
          <Description>Link to documentation</Description>
          <Id>Documentation</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Steps</Name>
          <Label>Steps</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Document the Entity Permissions and Web Roles for each Power Pages site. Confirm scope is the minimum required and that anonymous-accessible content is genuinely public.</Value>
          </Values>
          <Description>Perscriptive guidance on how to implement mitigations.</Description>

      <Id>TH4</Id>
      <ShortTitle>An adversary can gain unauthorized access to {target.Name} due to loose authorization rules</ShortTitle>
      <Category>E</Category>
      <Description>Database access should be configured with roles and privilege based on least privilege and need to know principle. </Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>

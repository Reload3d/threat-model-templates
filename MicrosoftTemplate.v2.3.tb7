        <Include>(target is '5a87c66d-ed7a-4643-bd94-4f93f928936c' or target is '49c5c2ef-6e15-43fe-9f4a-7f6d4adea402' or target is 'd3d035c3-f85e-4216-8e19-1c7a053e038c' or target is '7b957a0d-0c19-4b6d-8000-2fb177febe9f' or target is 'a9e4eebe-6ab1-40f0-8781-a5daf0541df1' or target is '86162e77-2d5c-432b-9145-7a4c7e442e99' or target is '07dfca9a-6c19-42f7-8226-309610e538f3' or target is '7095d97c-21c6-4d0e-b938-207abb4219a1' or target is 'a122570f-ce22-4852-819f-27c27f0b06bd' or target is 'b593a1b1-cda1-4e9d-965c-6c260a40f455' or target is 'SE.AS.TMCore.CognitiveServices' or target is 'SE.AS.TMCore.BotService')</Include>

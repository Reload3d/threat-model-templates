        <ThreatMetaDatum>
          <Name>PossibleMitigations</Name>
          <Label>Possible Mitigation(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Ensure that devices have end point security controls configured as per organizational policies. Refer:
&lt;a href="https://aka.ms/tmtconfigmgmt#controls-policies"&gt;https://aka.ms/tmtconfigmgmt#controls-policies&lt;/a&gt;</Value>
          </Values>

      <Id>TH233</Id>
      <ShortTitle>No-code AI agent platforms may allow business users to deploy agents that act on company systems without change control</ShortTitle>
      <Category>R</Category>
      <Description>No-code AI agent platforms (Lindy and similar) are positioned for business users to build agents that perform real actions: send emails, update CRMs, route leads, contact customers. These agents typically run under the building user's identity or under a shared platform identity, with no SDLC review, no audit pipeline integrated with engineering systems, and no mandatory tagging for compliance. Actions taken by the agent are difficult to attribute after the fact.</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>
          <Values>
            <Value xsi:nil="true" />
          </Values>
          <Id>22222222-2222-2222-2222-222222222222</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>UserThreatDescription</Name>
          <Label>Description</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>No-code AI agent platforms (Lindy and similar) are positioned for business users to build agents that perform real actions: send emails, update CRMs, route leads, contact customers. These agents typically run under the building user's identity or under a shared platform identity, with no SDLC review, no audit pipeline integrated with engineering systems, and no mandatory tagging for compliance. Actions taken by the agent are difficult to attribute after the fact.</Value>
          </Values>
          <Id>22222222-2222-2222-2222-222222222222</Id>

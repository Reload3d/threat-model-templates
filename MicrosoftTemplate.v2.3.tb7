          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>https://postmarkapp.com/developer/templates</Value>
          </Values>
          <Description>Link to documentation</Description>
          <Id>Documentation</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Steps</Name>
          <Label>Steps</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>List the templates used, the principals with edit rights, and the change-control process. Confirm production templates are versioned and that revisions are audited.</Value>

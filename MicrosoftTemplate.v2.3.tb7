          <Name>Documentation</Name>
          <Label>Documentation</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>https://docs.aws.amazon.com/documentdb/latest/developerguide/security.html</Value>
          </Values>
          <Description>Link to documentation</Description>
          <Id>Documentation</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Steps</Name>
          <Label>Steps</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>For each DocumentDB cluster, document the tenancy model (collection per tenant vs shared) and the access controls. Confirm application-tier filtering covers every query path or tenancy is enforced at storage level.</Value>
          </Values>
          <Description>Perscriptive guidance on how to implement mitigations.</Description>
          <Id>Steps</Id>

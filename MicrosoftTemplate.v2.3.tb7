          <Label>Documentation</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>https://learn.microsoft.com/en-us/azure/logic-apps/logic-apps-securing-a-logic-app</Value>
          </Values>
          <Description>Link to documentation</Description>
          <Id>Documentation</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Steps</Name>
          <Label>Steps</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>List each Logic App, the trigger type, the editor set, the connections referenced, and the managed identity attached. Confirm change control on workflow edits and protection of HTTP trigger URLs.</Value>
          </Values>
          <Description>Perscriptive guidance on how to implement mitigations.</Description>
          <Id>Steps</Id>
          <AttributeType>2</AttributeType>
        </ThreatMetaDatum>

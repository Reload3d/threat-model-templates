      <ShortTitle>An adversary can gain access to sensitive data by sniffing traffic from Mobile client</ShortTitle>
      <Category>I</Category>
      <Description>An adversary can gain access to sensitive data by sniffing traffic from Mobile client</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>
          <Values>
            <Value xsi:nil="true" />
          </Values>

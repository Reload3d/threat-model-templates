          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>PossibleMitigations</Name>
          <Label>Possible Mitigation(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Govern Fabric tenant settings as a security-impacting change requiring documented approval from the data protection function. Use security groups in tenant settings to scope risky capabilities to specific workspaces rather than enabling tenant-wide. Maintain an inventory of tenant settings and their last reviewed state.</Value>
          </Values>
          <Description>List of possbile mitigations.</Description>
          <Id>PossibleMitigations</Id>
          <AttributeType>2</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>

          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>https://learn.microsoft.com/en-us/fabric/data-science/how-to-create-data-agent</Value>
          </Values>
          <Description>Link to documentation</Description>
          <Id>Documentation</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Steps</Name>
          <Label>Steps</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>List each Data Agent and its bound sources, the data classification of each source, and the user populations that can call the agent. Confirm the agent's effective access matches the least-privileged source.</Value>
          </Values>
          <Description>Perscriptive guidance on how to implement mitigations.</Description>

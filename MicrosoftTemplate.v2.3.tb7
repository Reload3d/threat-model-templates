          <Name>Documentation</Name>
          <Label>Documentation</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>https://learn.microsoft.com/en-us/azure/storage/blobs/anonymous-read-access-prevent</Value>
          </Values>
          <Description>Link to documentation</Description>
          <Id>Documentation</Id>

          <Name>Documentation</Name>
          <Label>Documentation</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>https://docs.aws.amazon.com/vpc/latest/userguide/vpc-security-groups.html</Value>
          </Values>
          <Description>Link to documentation</Description>
          <Id>Documentation</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Steps</Name>
          <Label>Steps</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>List security groups in scope and any rules with 0.0.0.0/0 or ::/0 source on management or database ports. Confirm exceptions are explicit and time-bounded.</Value>

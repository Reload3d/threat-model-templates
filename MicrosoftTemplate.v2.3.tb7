          </Values>
          <Description>Priority</Description>
          <Id>22222222-2222-2222-2222-222222222222</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>PossibleMitigations</Name>
          <Label>Possible Mitigation(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Configure SSL certificate for custom domain in Azure App Service. Refer: &lt;a href="https://aka.ms/tmtcommsec#ssl-appservice"&gt;
https://aka.ms/tmtcommsec#ssl-appservice&lt;/a&gt; Force all traffic to Azure App Service over HTTPS connection . Refer:
&lt;a href="https://aka.ms/tmtcommsec#appservice-https"&gt;https://aka.ms/tmtcommsec#appservice-https&lt;/a&gt;</Value>
          </Values>
          <Description>List of possbile mitigations.</Description>
          <Id>PossibleMitigations</Id>
          <AttributeType>2</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>SDLPhase</Name>
          <Label>SDL Phase</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Implementation</Value>

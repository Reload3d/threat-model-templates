          <Name>PossibleMitigations</Name>
          <Label>Possible Mitigation(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Ensure that all admin interfaces are secured with strong credentials. Refer:
&lt;a href="https://aka.ms/tmtconfigmgmt#admin-strong"&gt;https://aka.ms/tmtconfigmgmt#admin-strong&lt;/a&gt;</Value>
          </Values>

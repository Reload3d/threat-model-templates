          <Name>Documentation</Name>
          <Label>Documentation</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>https://learn.microsoft.com/en-us/azure/cost-management-billing/manage/cost-management-budget-scenario</Value>
          </Values>
          <Description>Link to documentation</Description>
          <Id>Documentation</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Steps</Name>
          <Label>Steps</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>List consumption-billed services reachable from untrusted callers. For each, document the rate-limit policy, budget alerts, and response actions on threshold breach.</Value>

            <Value>https://csf.tools/reference/cloud-controls-matrix/v4-0/dsi/dsi-04/</Value>
          </Values>
          <Description>Link to documentation</Description>
          <Id>Documentation</Id>
          <AttributeType>0</AttributeType>

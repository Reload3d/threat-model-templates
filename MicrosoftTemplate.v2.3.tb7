            <Value>https://csf.tools/reference/cloud-controls-matrix/v4-0/dsi/dsi-02/</Value>
          </Values>
          <Description>Link to documentation</Description>
          <Id>Documentation</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Steps</Name>
          <Label>Steps</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Document the access controls applied to each HR/payroll SaaS. Confirm they are stricter than the general SaaS baseline and align with the data sensitivity.</Value>
          </Values>
          <Description>Perscriptive guidance on how to implement mitigations.</Description>
          <Id>Steps</Id>
          <AttributeType>2</AttributeType>

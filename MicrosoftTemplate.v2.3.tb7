          <Name>Documentation</Name>
          <Label>Documentation</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>https://docs.aws.amazon.com/bedrock/latest/userguide/model-invocation-logging.html</Value>
          </Values>
          <Description>Link to documentation</Description>
          <Id>Documentation</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Steps</Name>
          <Label>Steps</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>For each Bedrock account or model in scope, document whether invocation logging is enabled, the log destination and retention, and access controls on the logs.</Value>
          </Values>
          <Description>Perscriptive guidance on how to implement mitigations.</Description>

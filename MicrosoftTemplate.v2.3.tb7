          <Name>Documentation</Name>
          <Label>Documentation</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>https://learn.microsoft.com/en-us/fabric/onelake/security/get-started-security</Value>
          </Values>
          <Description>Link to documentation</Description>
          <Id>Documentation</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Steps</Name>
          <Label>Steps</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>List every report, pipeline, and notebook that joins or unions multiple lakehouses or warehouses. For each, confirm all referenced sources will have OneLake Security in the same state after enablement.</Value>
          </Values>
          <Description>Perscriptive guidance on how to implement mitigations.</Description>

          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>https://aws.amazon.com/compliance/data-residency/</Value>
          </Values>
          <Description>Link to documentation</Description>
          <Id>Documentation</Id>
          <AttributeType>0</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>Steps</Name>
          <Label>Steps</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>For each AWS data resource in scope, document the primary region, replication targets, and the residency requirement. Confirm replication targets are compliant.</Value>
          </Values>
          <Description>Perscriptive guidance on how to implement mitigations.</Description>
          <Id>Steps</Id>

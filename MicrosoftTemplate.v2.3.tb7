            <Value>Medium</Value>
          </Values>
          <Description>Priority</Description>
          <Id>22222222-2222-2222-2222-222222222222</Id>
          <AttributeType>1</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>PossibleMitigations</Name>
          <Label>Possible Mitigation(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Use guest-restricted workspaces or projects for external collaboration rather than inviting guests into mixed-content workspaces. Where the SaaS supports per-item guest permissions, scope strictly. Audit guest membership and review on a defined cadence; automatically deprovision guests after a period of inactivity. Train inviters on the guest visibility model of each platform.</Value>
          </Values>
          <Description>List of possbile mitigations.</Description>
          <Id>PossibleMitigations</Id>
          <AttributeType>2</AttributeType>
        </ThreatMetaDatum>

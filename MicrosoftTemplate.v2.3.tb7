        <Exclude>(target.ShowAzureServiceThreat is 'No' or target.ShowAzureAssetThreat is 'No' or target.ShowAzureDataServiceThreat is 'No' or flow.ShowBoundaryThreats is 'No' or source.ShowAzureServiceThreat is 'No' or source.ShowAzureAssetThreat is 'No' or source.ShowAzureDataServiceThreat is 'No')</Exclude>

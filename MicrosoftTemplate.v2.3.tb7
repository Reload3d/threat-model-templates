      <Id>TH70</Id>
      <ShortTitle>An adversary can potentially spoof a client if weaker client authentication channels are used</ShortTitle>
      <Category>S</Category>
      <Description>Azure AD authentication provides better control on identity management and hence it is a better alternative to authenticate clients to Service Fabric</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>

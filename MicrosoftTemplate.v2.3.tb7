        </ThreatMetaDatum>
        <ThreatMetaDatum>
          <Name>PossibleMitigations</Name>
          <Label>Possible Mitigation(s)</Label>
          <HideFromUI>false</HideFromUI>
          <Values>
            <Value>Ensure that least-privileged accounts are used to connect to Database server. Refer:
&lt;a href="https://aka.ms/tmtauthz#privileged-server"&gt;https://aka.ms/tmtauthz#privileged-server&lt;/a&gt; Implement Row Level Security RLS to prevent tenants from accessing each others data. Refer:
&lt;a href="https://aka.ms/tmtauthz#rls-tenants"&gt;https://aka.ms/tmtauthz#rls-tenants&lt;/a&gt; Sysadmin role should only have valid necessary users . Refer:
&lt;a href="https://aka.ms/tmtauthz#sysadmin-users"&gt;https://aka.ms/tmtauthz#sysadmin-users&lt;/a&gt;</Value>
          </Values>
          <Description>List of possbile mitigations.</Description>
          <Id>PossibleMitigations</Id>
          <AttributeType>2</AttributeType>

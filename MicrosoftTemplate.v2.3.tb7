      <Category>I</Category>
      <Description>An adversary may sniff the data sent from Identity Server. This can lead to a compromise of the tokens issued by the Identity Server</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
          <Label>Short Description</Label>
          <HideFromUI>true</HideFromUI>

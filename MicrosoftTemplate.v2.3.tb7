          <Values>
            <Value>Use per-device authentication credentials. Refer: &lt;a href="https://aka.ms/tmtauthn#authn-cred"&gt;
https://aka.ms/tmtauthn#authn-cred&lt;/a&gt;</Value>
          </Values>
          <Description>List of possbile mitigations.</Description>
          <Id>PossibleMitigations</Id>
          <AttributeType>2</AttributeType>
        </ThreatMetaDatum>
        <ThreatMetaDatum>

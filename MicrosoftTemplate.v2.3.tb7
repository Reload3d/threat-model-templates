      <Id>TH41</Id>
      <ShortTitle>An adversary may gain unauthorized access to privileged features on {source.Name}</ShortTitle>
      <Category>E</Category>
      <Description>An adversary may get access to admin interface or privileged services like WiFi, SSH, File shares, FTP etc., on a device</Description>
      <PropertiesMetaData>
        <ThreatMetaDatum>
          <Name>UserThreatShortDescription</Name>
